generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  username         String   @unique @db.VarChar(50)
  email            String   @unique @db.VarChar(255)
  password         String   @db.VarChar(255)
  preferredCountry String?  @map("preferred_country") @db.VarChar(100)
  preferredState   String?  @map("preferred_state") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")

  cellPaints        CellPaint[]
  tribeMarkers      TribeMarker[]
  playerSettlements PlayerSettlement[]

  @@map("users")
}

model CellPaint {
  id        String   @id @default(uuid()) @db.Uuid
  cellKey   String   @map("cell_key") @db.VarChar(50)
  userId    String?  @map("user_id") @db.Uuid
  paintedAt DateTime @default(now()) @map("painted_at")
  terrainId String?  @map("terrain_id") @db.Uuid
  regionId  String   @map("region_id") @db.Uuid

  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  terrain Terrain?  @relation(fields: [terrainId], references: [id])
  region  MapRegion @relation(fields: [regionId], references: [id])

  @@index([regionId, cellKey, paintedAt(sort: Desc)], name: "cell_paints_lookup")
  @@map("cell_paints")
}

model ResourceType {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(30)
  tier Int    @default(1)

  resources                 Resource[]
  playerSettlements         PlayerSettlement[]
  processedProductionChains ProductionChain[]  @relation("ProcessedCategory")
  final1ProductionChains    ProductionChain[]  @relation("Final1Category")
  final2ProductionChains    ProductionChain[]  @relation("Final2Category")

  @@map("resource_types")
}

model Resource {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @unique @db.VarChar(100)
  resourceTypeId String  @map("resource_type_id") @db.Uuid
  icon           String? @db.VarChar(20)
  info           String?
  available      Boolean @default(true)

  resourceType ResourceType       @relation(fields: [resourceTypeId], references: [id])
  locations    ResourceLocation[]
  chain        ProductionChain?

  @@map("resources")
}

model Terrain {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(50)
  color String @db.VarChar(20)
  icon  String @db.VarChar(10)

  locations  Location[]
  cellPaints CellPaint[]

  @@map("terrains")
}

model Location {
  id        String @id @default(uuid()) @db.Uuid
  name      String @db.VarChar(100)
  terrainId String @map("terrain_id") @db.Uuid

  terrain           Terrain            @relation(fields: [terrainId], references: [id])
  resourceLocations ResourceLocation[]

  @@unique([name, terrainId])
  @@map("locations")
}

model ResourceLocation {
  id         String @id @default(uuid()) @db.Uuid
  resourceId String @map("resource_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  stars      Int    @default(0) @db.SmallInt

  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  locationRef Location @relation(fields: [locationId], references: [id])

  @@unique([resourceId, locationId])
  @@map("resource_locations")
}

model ProductionChain {
  id                  String  @id @default(uuid()) @db.Uuid
  resourceId          String  @unique @map("resource_id") @db.Uuid
  processedName       String  @map("processed_name") @db.VarChar(100)
  processedCategoryId String  @map("processed_category_id") @db.Uuid
  final1Name          String? @map("final1_name") @db.VarChar(100)
  final1CategoryId    String? @map("final1_category_id") @db.Uuid
  final2Name          String? @map("final2_name") @db.VarChar(100)
  final2CategoryId    String? @map("final2_category_id") @db.Uuid

  resource             Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  processedCategoryRef ResourceType  @relation("ProcessedCategory", fields: [processedCategoryId], references: [id])
  final1CategoryRef    ResourceType? @relation("Final1Category",    fields: [final1CategoryId],    references: [id])
  final2CategoryRef    ResourceType? @relation("Final2Category",    fields: [final2CategoryId],    references: [id])

  @@map("production_chain")
}

model MapRegion {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  parentId  String?  @map("parent_id") @db.Uuid
  latMin    Decimal  @map("lat_min") @db.Decimal(7, 4)
  latMax    Decimal  @map("lat_max") @db.Decimal(7, 4)
  lngMin    Decimal  @map("lng_min") @db.Decimal(8, 4)
  lngMax    Decimal  @map("lng_max") @db.Decimal(8, 4)
  centerLat Decimal? @map("center_lat") @db.Decimal(7, 4)
  centerLng Decimal? @map("center_lng") @db.Decimal(8, 4)
  zoom      Int?     @db.SmallInt

  parentRegion      MapRegion?         @relation("RegionParent", fields: [parentId], references: [id])
  childRegions      MapRegion[]        @relation("RegionParent")
  cellPaints        CellPaint[]
  tribeMarkers      TribeMarker[]
  playerSettlements PlayerSettlement[]

  @@map("map_regions")
}

model Tribe {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique @db.VarChar(100)
  color String @db.VarChar(20)
  icon  String @db.VarChar(10)

  markers TribeMarker[]

  @@map("tribes")
}

model TribeType {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(20)

  markers TribeMarker[]

  @@map("tribe_types")
}

model TribeMarker {
  id          String   @id @default(uuid()) @db.Uuid
  placedBy    String   @map("placed_by") @db.Uuid
  tribeId     String   @map("tribe_id") @db.Uuid
  tribeTypeId String   @map("tribe_type_id") @db.Uuid
  regionId    String   @map("region_id") @db.Uuid
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [placedBy], references: [id], onDelete: Cascade)
  tribe     Tribe     @relation(fields: [tribeId], references: [id])
  tribeType TribeType @relation(fields: [tribeTypeId], references: [id])
  region    MapRegion @relation(fields: [regionId], references: [id])

  @@index([regionId], name: "tribe_markers_region")
  @@map("tribe_markers")
}

model SettlementStage {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique @db.VarChar(100)
  sortOrder Int    @default(0) @map("sort_order")
  tier      Int    @default(1) @db.SmallInt
  icon      String @db.VarChar(10)

  settlements PlayerSettlement[]

  @@map("settlement_stages")
}

model PlayerSettlement {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  stageId        String   @map("stage_id") @db.Uuid
  regionId       String   @map("region_id") @db.Uuid
  resourceTypeId String?  @map("resource_type_id") @db.Uuid
  lat            Decimal  @db.Decimal(9, 6)
  lng            Decimal  @db.Decimal(9, 6)
  name           String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")
  isPublic       Boolean  @default(false) @map("is_public")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage           SettlementStage  @relation(fields: [stageId], references: [id])
  region          MapRegion        @relation(fields: [regionId], references: [id])
  resourceTypeRef ResourceType?    @relation(fields: [resourceTypeId], references: [id])

  @@index([regionId], name: "player_settlements_region")
  @@map("player_settlements")
}
