# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=terrain_map
DB_USER=terrain
DB_PASSWORD=change_me

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
# COOKIE_SECURE=true   ← uncomment when deploying behind HTTPS
ALLOWED_ORIGINS=http://localhost:5174   # comma-separated; set to your domain(s) in production
APP_URL=http://localhost:5174           # public URL used in OG tags (set to your domain in production)
PORT=3001

# ── Auth (generate with: openssl rand -hex 64) ────────────────────────────────
JWT_SECRET=change_me

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_TRIBE_MARKERS=50
MAX_SETTLEMENTS=50
MAX_PUBLIC_SETTLEMENTS=10

# ── Features ──────────────────────────────────────────────────────────────────
STAR_EDITING=true   # set to false to disable community star ratings

# ── Privacy policy contact ────────────────────────────────────────────────────
CONTACT_NAME=Your Name
CONTACT_DISCORD=https://discord.gg/ytmhADQZP5
# CONTACT_EMAIL=you@example.com   ← optional, shown alongside Discord
